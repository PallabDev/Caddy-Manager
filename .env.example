# ==============================================================================
# CADDY MANAGER ENVIRONMENT CONFIGURATION (EXAMPLE TEMPLATE)
# ==============================================================================

# Public Domain assigned to this Caddy Manager software
CADDY_MANAGER_DOMAIN=localhost

# Local Port Caddy Manager UI & API listens on
CADDY_MANAGER_PORT=3000

# Initial Bootstrap Administrator Email
# When this Google Account logs in, it automatically gets admin=true and isAccess=true
CADDY_MANAGER_USER_EMAIL=admin@example.com

# Target Public IP of your server to provide users for DNS A-Records
SERVER_PUBLIC_IP=your_server_ip_here

# Database credentials (customize for your deployment)
DB_USER=ServerCaddy
DB_PASSWORD=your_secure_password_here
DB_NAME=caddy_manager

# Database connection URL (for local development outside Docker)
DATABASE_URL=postgresql://ServerCaddy:your_secure_password_here@localhost:5432/caddy_manager

# Better Auth Secret (generate a random 32+ character key)
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_key_here

# Canonical App URL
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Caddy Admin API Endpoint (port 2019)
CADDY_ADMIN_API_URL=http://localhost:2019

# Path to persistent Caddyfile on host/container
CADDY_CONFIG_PATH=./caddy/Caddyfile
